/* =========================================================
   关于我们页样式 · 苹果式浅色极简
   ========================================================= */

/* 公司头部：浅底大字排版，无色块装饰 */
.company-header {
  padding: 72rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.company-logo-wrap {
  width: 140rpx;
  height: 140rpx;
  background: #1D1D1F;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}
.company-logo-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}
.company-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  text-align: center;
  letter-spacing: -0.5rpx;
}
.company-slogan {
  font-size: 24rpx;
  color: #86868B;
  text-align: center;
  letter-spacing: 3rpx;
}

/* 数据带 */
.stat-band {
  display: flex;
  align-items: center;
  background: #1D1D1F;
  border-radius: 36rpx;
  margin: 8rpx 32rpx 16rpx;
  padding: 40rpx 24rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -1rpx;
  line-height: 1.2;
}
.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}
.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.14);
  flex-shrink: 0;
}

/* 简介 */
.intro-card {
  margin: 0 32rpx;
}
.intro-text { font-size: 28rpx; color: #424245; line-height: 1.95; }

/* 优势宫格 */
.advantages-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}
.adv-item {
  width: calc(50% - 24rpx);
  margin: 8rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 36rpx 20rpx;
  box-sizing: border-box;
}
.adv-icon {
  font-size: 56rpx;
  margin-bottom: 18rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  background: #F5F5F7;
  display: flex;
  align-items: center;
  justify-content: center;
}
.adv-title { font-size: 28rpx; font-weight: 700; color: #1D1D1F; margin-bottom: 8rpx; letter-spacing: -0.3rpx; }
.adv-desc { font-size: 22rpx; color: #AEAEB2; line-height: 1.6; }

/* 资质 */
.cert-card { margin: 0 32rpx; }
.cert-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}
.cert-item:last-of-type { border-bottom: none; }
.cert-check {
  color: #34C759;
  font-size: 28rpx;
  font-weight: 800;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cert-name { font-size: 28rpx; color: #1D1D1F; font-weight: 500; }
.cert-note {
  font-size: 22rpx;
  color: #AEAEB2;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* 联系方式（iOS 设置组） */
.contact-card { margin: 0 32rpx 24rpx; padding: 8rpx 32rpx; }
.contact-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  transition: opacity 0.2s ease;
}
.contact-row:active { opacity: 0.6; }
.contact-divider { height: 1rpx; background: rgba(0, 0, 0, 0.05); }

.contact-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F5F5F7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.contact-icon { font-size: 30rpx; color: #1565C0; }

.contact-info { flex: 1; display: flex; flex-direction: column; }
.contact-label { font-size: 22rpx; color: #86868B; margin-bottom: 6rpx; }
.contact-value { font-size: 28rpx; color: #1D1D1F; font-weight: 500; }
.phone-blue { color: #1565C0; font-weight: 700; letter-spacing: 0.5rpx; }

.contact-action {
  font-size: 24rpx;
  color: #1565C0;
  background: rgba(21, 101, 192, 0.10);
  padding: 12rpx 28rpx;
  border-radius: 980rpx;
  font-weight: 600;
}
