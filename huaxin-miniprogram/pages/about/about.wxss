/* =========================================================
   关于我们页样式
   ========================================================= */

/* 公司头部（带装饰圆 + 底部弧形过渡） */
.company-header {
  position: relative;
  background: linear-gradient(160deg, #0D47A1 0%, #1565C0 50%, #1976D2 100%);
  padding: 80rpx 40rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}
.company-header::before,
.company-header::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}
.company-header::before {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -100rpx;
}
.company-header::after {
  width: 200rpx;
  height: 200rpx;
  bottom: -60rpx;
  left: -60rpx;
}
.company-header-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
  height: 60rpx;
  background: #F7F8FA;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
}

.company-logo-wrap {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255,255,255,0.22);
  backdrop-filter: blur(8rpx);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.18);
  z-index: 1;
}
.company-logo-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}
.company-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 14rpx;
  text-align: center;
  letter-spacing: 1rpx;
  z-index: 1;
}
.company-slogan {
  font-size: 24rpx;
  color: rgba(255,255,255,0.88);
  text-align: center;
  letter-spacing: 3rpx;
  z-index: 1;
}

/* 简介（左侧蓝色竖线） */
.intro-card {
  margin: 12rpx 24rpx;
  position: relative;
  padding-left: 46rpx;
}
.intro-card::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 32rpx;
  bottom: 32rpx;
  width: 6rpx;
  background: linear-gradient(180deg, #1565C0, #1976D2);
  border-radius: 4rpx;
}
.intro-text { font-size: 28rpx; color: #1A2233; line-height: 1.95; }

/* 优势宫格 */
.advantages-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}
.adv-item {
  width: calc(50% - 36rpx);
  margin: 8rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 36rpx 20rpx;
  transition: transform .15s ease;
}
.adv-item:active { transform: scale(0.98); }
.adv-icon {
  font-size: 60rpx;
  margin-bottom: 18rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #E8F2FE 0%, #F0F4FA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.adv-title { font-size: 28rpx; font-weight: 700; color: #1A2233; margin-bottom: 8rpx; }
.adv-desc { font-size: 22rpx; color: #97A3B4; line-height: 1.6; }

/* 资质（绿色徽章风） */
.cert-card { margin: 12rpx 24rpx; }
.cert-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F4FA;
}
.cert-item:last-of-type { border-bottom: none; }
.cert-check {
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #43A047, #2E7D32);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 50, 0.30);
  flex-shrink: 0;
}
.cert-name { font-size: 28rpx; color: #1A2233; font-weight: 500; }
.cert-note {
  font-size: 22rpx;
  color: #97A3B4;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0F4FA;
}

/* 联系方式 */
.contact-card { margin: 12rpx 24rpx 24rpx; padding: 8rpx 28rpx; }
.contact-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  transition: background .15s ease;
}
.contact-row:active {
  background: #FAFBFD;
  border-radius: 12rpx;
  margin: 0 -12rpx;
  padding: 28rpx 12rpx;
}
.contact-divider { height: 1rpx; background: #F0F4FA; }

/* 联系方式：图标圆形渐变背景 */
.contact-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F2FE, #F0F4FA);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.contact-icon { font-size: 32rpx; color: #1565C0; }

.contact-info { flex: 1; display: flex; flex-direction: column; }
.contact-label { font-size: 22rpx; color: #97A3B4; margin-bottom: 6rpx; }
.contact-value { font-size: 28rpx; color: #1A2233; font-weight: 500; }
.phone-blue { color: #1565C0; font-weight: 700; letter-spacing: 1rpx; }

.contact-action {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #1565C0, #1976D2);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 10rpx rgba(21, 101, 192, 0.25);
}
