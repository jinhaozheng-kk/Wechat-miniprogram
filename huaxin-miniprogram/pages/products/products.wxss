/* =========================================================
   产品列表页样式 · 苹果式浅色极简
   ========================================================= */

/* 页头样式已全局化（app.wxss .page-head） */

/* 搜索栏（顶部 sticky，iOS 搜索框风格） */
.search-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(245, 245, 247, 0.85);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  padding: 20rpx 32rpx 20rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 24rpx;
  padding: 16rpx 26rpx;
  transition: background 0.2s ease;
}
.search-bar.focused {
  background: rgba(0, 0, 0, 0.08);
}
.search-icon { font-size: 30rpx; margin-right: 14rpx; color: #86868B; filter: grayscale(1); opacity: 0.6; }
.search-input { flex: 1; font-size: 30rpx; height: 56rpx; color: #1D1D1F; }
.search-placeholder { color: #AEAEB2; }
.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.12);
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 搜索结果 */
.result-item {
  margin: 14rpx 32rpx;
  padding: 30rpx 32rpx;
  display: flex;
  align-items: center;
}
.result-img {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  margin-right: 28rpx;
  filter: drop-shadow(0 6rpx 12rpx rgba(0, 0, 0, 0.10));
}
.result-body { flex: 1; min-width: 0; }
.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 6rpx;
  line-height: 1.4;
  letter-spacing: -0.3rpx;
}
.result-model { font-size: 24rpx; color: #86868B; margin-bottom: 14rpx; }
.result-tags { display: flex; flex-wrap: wrap; }

/* 搜索"未找到"空状态 + CTA */
.empty-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  color: #1565C0;
  font-size: 26rpx;
  font-weight: 500;
}

/* 产品墙：双列图片网格（苹果商店产品墙风） */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 22rpx 0;
}
.cat-tile {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  padding: 36rpx 24rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cat-tile-img {
  width: 100%;
  height: 240rpx;
  margin-bottom: 22rpx;
  filter: drop-shadow(0 10rpx 18rpx rgba(0, 0, 0, 0.10));
}
.cat-tile-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.3rpx;
  text-align: center;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cat-tile-count {
  font-size: 22rpx;
  color: #86868B;
  margin-top: 8rpx;
}
.cat-tile-count.preparing { color: #C7C7CC; }

/* 非标定制卡（深色反差） */
.custom-card {
  display: flex;
  align-items: center;
  background: #1D1D1F;
  border-radius: 32rpx;
  margin: 28rpx 32rpx 0;
  padding: 36rpx 40rpx;
}
.empty-state .custom-card {
  width: 100%;
  margin: 48rpx 0 0;
  box-sizing: border-box;
}
/* 置顶版：紧贴搜索栏，与下方分类列表留出呼吸感 */
.custom-card-top {
  margin: 4rpx 32rpx 8rpx;
}
.custom-text { flex: 1; }
.custom-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.3rpx;
  margin-bottom: 6rpx;
}
.custom-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}
.custom-btn {
  background: #1565C0;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 34rpx;
  border-radius: 980rpx;
  flex-shrink: 0;
}
