<view class="page-container">

  <!-- 提交成功视图 -->
  <block wx:if="{{submitted}}">
    <view class="success-box">
      <view class="success-icon">✓</view>
      <view class="success-title">{{isCustom ? '定制需求已提交' : '询价提交成功'}}</view>
      <view class="success-sub">{{isCustom ? '销售将在 1 个工作日内联系您对接图纸与报价' : '销售将在 1 个工作日内联系您'}}</view>
      <view class="success-actions">
        <button class="btn-primary success-btn" bindtap="backHome">返回首页</button>
        <button class="btn-secondary success-btn" bindtap="submitAnother">再提交一单</button>
      </view>
    </view>
  </block>

  <!-- 表单视图 -->
  <block wx:else>

    <!-- 编辑部式页头 -->
    <view class="page-head reveal">
      <view class="page-head-title">{{isCustom ? '非标定制' : '询价'}}</view>
      <view class="page-head-sub">{{isCustom ? '填写参数，销售对接图纸与报价' : '1 个工作日内回复出厂价'}}</view>
    </view>

    <!-- 非标定制模式提示行 -->
    <view wx:if="{{isCustom}}" class="custom-hint reveal reveal-d1">
      <text class="custom-hint-text">来图来样 · 尺寸 / 材质 / 工艺均可定</text>
      <text class="custom-hint-exit" bindtap="exitCustomMode">普通询价 ›</text>
    </view>

    <!-- 询价产品（定制模式下隐藏，不强制选品） -->
    <view wx:if="{{!isCustom}}" class="section-title">询价产品</view>
    <view wx:if="{{!isCustom}}" class="card products-card">
      <block wx:if="{{products.length > 0}}">
        <view wx:for="{{products}}" wx:key="id" class="product-row">
          <view class="product-index">{{index + 1}}</view>
          <view class="product-info">
            <view class="product-name">{{item.name}}</view>
            <view class="product-model">型号：{{item.model}}</view>
          </view>
          <view
            class="product-remove"
            bindtap="removeProduct"
            data-id="{{item.id}}"
          >移除</view>
        </view>
      </block>
      <view wx:else class="empty-products">
        <text class="empty-tip">暂未选择产品</text>
        <view class="empty-link" bindtap="goToProducts">去浏览产品 ›</view>
      </view>
    </view>

    <!-- 联系信息 -->
    <view class="section-title">联系信息</view>
    <view class="card form-card">
      <view class="form-row">
        <view class="form-label"><text class="required">*</text>联系人</view>
        <input
          class="form-input"
          placeholder="请输入姓名"
          maxlength="20"
          value="{{form.contactName}}"
          data-field="contactName"
          bindinput="onFieldInput"
        />
      </view>
      <view class="form-row">
        <view class="form-label"><text class="required">*</text>电话</view>
        <input
          class="form-input"
          placeholder="请输入手机号"
          type="number"
          maxlength="11"
          value="{{form.contactPhone}}"
          data-field="contactPhone"
          bindinput="onFieldInput"
        />
      </view>
      <view class="form-row">
        <view class="form-label">所在城市</view>
        <input
          class="form-input"
          placeholder="选填，如：杭州市"
          maxlength="32"
          value="{{form.city}}"
          data-field="city"
          bindinput="onFieldInput"
        />
      </view>
      <view class="form-row">
        <view class="form-label">工程名称</view>
        <input
          class="form-input"
          placeholder="选填，便于报价单归档"
          maxlength="100"
          value="{{form.projectName}}"
          data-field="projectName"
          bindinput="onFieldInput"
        />
      </view>
    </view>

    <!-- 需求与备注 -->
    <view class="section-title">{{isCustom ? '定制需求' : '需求描述'}}</view>
    <view wx:if="{{isCustom}}" class="section-caption">已为您预填模板，请补全各项参数</view>
    <view class="card form-card">
      <view class="form-row form-row-block">
        <view class="form-label"><text class="required">*</text>{{isCustom ? '定制参数' : '需求'}}</view>
        <textarea
          class="form-textarea {{isCustom ? 'form-textarea-tall' : ''}}"
          placeholder="请填写数量、规格；非标定制请注明尺寸、材质、开孔等"
          maxlength="500"
          value="{{form.requirement}}"
          data-field="requirement"
          bindinput="onFieldInput"
          auto-height
        />
      </view>
      <view class="form-row form-row-block">
        <view class="form-label">备注</view>
        <textarea
          class="form-textarea"
          placeholder="选填，最多 200 字"
          maxlength="200"
          value="{{form.remark}}"
          data-field="remark"
          bindinput="onFieldInput"
          auto-height
        />
      </view>
    </view>

    <!-- 提示 -->
    <view class="note-card card">
      <view class="note-title">温馨提示</view>
      <view class="note-item">· 接受各类非标箱定制：请在需求中写明尺寸、材质、厚度、开孔等，可来图来样</view>
      <view class="note-item">· 报价均为出厂价，不含税、不含发票、不含运费</view>
      <view class="note-item">· 如需开票或含运费报价，请在备注中说明</view>
      <view class="note-item">· 急单也可直接致电 {{company.phone}}</view>
    </view>

    <!-- 底部操作 -->
    <view class="bottom-actions">
      <button
        class="btn-primary submit-btn"
        bindtap="onSubmit"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >{{isCustom ? '提交定制需求' : '提交询价'}}</button>
      <view class="call-link" bindtap="callPhone">
        <text class="call-icon">☎</text>
        <text>直接拨打 {{company.phone}}</text>
      </view>
    </view>

  </block>

</view>
