/* =========================================================
   询价页样式 · 苹果式浅色极简（iOS 设置组风格表单）
   ========================================================= */

/* 非标定制模式提示行 */
.custom-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 32rpx 0;
  padding: 22rpx 32rpx;
  background: rgba(21, 101, 192, 0.07);
  border-radius: 24rpx;
}
.custom-hint-text {
  font-size: 24rpx;
  color: #1565C0;
  font-weight: 500;
}
.custom-hint-exit {
  font-size: 24rpx;
  color: #86868B;
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* 定制模式下的需求输入框加高 */
.form-textarea-tall { min-height: 320rpx; }

/* 询价产品列表 */
.products-card {
  margin: 0 32rpx;
  padding: 0;
}
.product-row {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}
.product-row:last-child { border-bottom: none; }

/* 序号小圆 */
.product-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(21, 101, 192, 0.10);
  color: #1565C0;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.product-info { flex: 1; min-width: 0; }
.product-name {
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.product-model { font-size: 22rpx; color: #AEAEB2; }
.product-remove {
  font-size: 22rpx;
  color: #FF3B30;
  padding: 10rpx 20rpx;
  border-radius: 980rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  background: rgba(255, 59, 48, 0.08);
  transition: background 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.product-remove:active { background: rgba(255, 59, 48, 0.16); transform: scale(0.94); }

.empty-products {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx;
}
.empty-tip { font-size: 26rpx; color: #AEAEB2; margin-bottom: 16rpx; }
.empty-link {
  font-size: 26rpx;
  color: #1565C0;
  font-weight: 600;
  padding: 14rpx 30rpx;
  background: rgba(21, 101, 192, 0.10);
  border-radius: 980rpx;
}

/* 表单卡片（iOS 设置组） */
.form-card {
  margin: 0 32rpx;
  padding: 0;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  min-height: 88rpx;
}
.form-row:last-child { border-bottom: none; }
.form-row-block {
  flex-direction: column;
  align-items: stretch;
}
.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 500;
  flex-shrink: 0;
}
.form-row-block .form-label {
  width: auto;
  margin-bottom: 14rpx;
}
.required {
  color: #FF3B30;
  margin-right: 4rpx;
  font-weight: 700;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1D1D1F;
  min-height: 48rpx;
}
.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #1D1D1F;
  min-height: 120rpx;
  line-height: 1.6;
  background: #F5F5F7;
  padding: 20rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}

/* 提示卡片：极简灰字说明 */
.note-card {
  margin: 24rpx 32rpx 32rpx;
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0 8rpx;
}
.note-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #86868B;
  margin-bottom: 10rpx;
}
.note-item {
  font-size: 22rpx;
  color: #AEAEB2;
  line-height: 1.85;
}

/* 底部操作 */
.bottom-actions {
  margin: 0 32rpx;
}
.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  background: #1565C0;
  color: #FFFFFF;
  border-radius: 980rpx;
  border: none;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
}
.submit-btn::after { border: none; }
.submit-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.call-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  color: #1565C0;
  font-size: 26rpx;
  font-weight: 500;
}
.call-icon { margin-right: 8rpx; font-size: 30rpx; }

/* 提交成功视图（弹性入场） */
.success-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx 80rpx;
}
.success-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #34C759;
  color: #fff;
  font-size: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  font-weight: 700;
  animation: bounce-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@keyframes bounce-in {
  0%   { transform: scale(0.3); opacity: 0; }
  60%  { transform: scale(1.10); opacity: 1; }
  80%  { transform: scale(0.95); }
  100% { transform: scale(1.00); }
}

.success-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 14rpx;
  letter-spacing: -0.5rpx;
  animation: fade-in-up 0.5s ease 0.3s both;
}
.success-sub {
  font-size: 26rpx;
  color: #86868B;
  margin-bottom: 64rpx;
  animation: fade-in-up 0.5s ease 0.4s both;
}
@keyframes fade-in-up {
  0%   { transform: translateY(20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.success-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  animation: fade-in-up 0.5s ease 0.5s both;
}
.success-btn {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 980rpx;
}
.success-btn.btn-primary {
  background: #1565C0;
  color: #FFFFFF;
  border: none;
}
.success-btn.btn-primary::after { border: none; }
.success-btn.btn-secondary {
  background: rgba(21, 101, 192, 0.10);
  color: #1565C0;
  border: none;
}
.success-btn.btn-secondary::after { border: none; }
