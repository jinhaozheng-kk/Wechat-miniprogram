/* =========================================================
   首页样式
   ========================================================= */

/* 轮播 Banner */
.banner-swiper {
  width: 100%;
  height: 400rpx;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
}
.banner-slide {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 44rpx;
  overflow: hidden;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(20, 50, 100, 0.18);
}

/* 背景装饰圆 */
.banner-deco-1 {
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.10);
}
.banner-deco-2 {
  position: absolute;
  right: 80rpx;
  bottom: -100rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}

/* 文字区 */
.banner-content {
  flex: 1;
  z-index: 1;
}
.banner-tag {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.22);
  backdrop-filter: blur(8rpx);
  color: rgba(255,255,255,0.98);
  font-size: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
  letter-spacing: 3rpx;
  font-weight: 500;
}
.banner-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.32;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
  white-space: pre-line;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
}
.banner-subtitle {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.7;
}

/* 产品图 */
.banner-product-img {
  width: 230rpx;
  height: 230rpx;
  flex-shrink: 0;
  z-index: 1;
  filter: drop-shadow(0 4rpx 16rpx rgba(0,0,0,0.18));
}

/* 电话条（白底卡片，左圆形图标 + 文字 + 右胶囊CTA） */
.phone-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 28rpx;
  margin: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 50, 100, 0.06);
  transition: transform .2s ease;
}
.phone-bar:active { transform: scale(0.99); }
.phone-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1565C0 0%, #1976D2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(21, 101, 192, 0.30);
}
.phone-icon {
  font-size: 40rpx;
  color: #fff;
}
.phone-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.phone-label {
  font-size: 22rpx;
  color: #97A3B4;
  margin-bottom: 4rpx;
}
.phone-number {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A2233;
  letter-spacing: 1rpx;
}
.phone-tip {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #1565C0, #1976D2);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 10rpx rgba(21, 101, 192, 0.25);
}

/* 分类宫格（白卡 + 圆角 + 阴影） */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  padding: 16rpx 8rpx 24rpx;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 50, 100, 0.06);
}
.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 4rpx;
  transition: transform .15s ease;
}
.category-item:active { transform: scale(0.94); }

.cat-img-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F0F4FA 0%, #E8F2FE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(20, 50, 100, 0.04);
}
.cat-img {
  width: 88rpx;
  height: 88rpx;
}
.cat-name {
  font-size: 22rpx;
  color: #1A2233;
  text-align: center;
  line-height: 1.4;
  max-width: 140rpx;
  overflow: hidden;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.cat-count {
  font-size: 20rpx;
  color: #1565C0;
  margin-top: 6rpx;
  font-weight: 500;
}
.cat-count.preparing {
  color: #C9D1DC;
  font-weight: 400;
}

/* 快捷询价 CTA 卡（大号渐变卡片） */
.inquiry-card {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1565C0 0%, #1976D2 60%, #1E88E5 100%);
  border-radius: 24rpx;
  margin: 0 24rpx 32rpx;
  padding: 36rpx 40rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(21, 101, 192, 0.30);
}
.inquiry-deco {
  position: absolute;
  right: -60rpx;
  top: -50rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.10);
}
.inquiry-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  z-index: 1;
}
.inquiry-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}
.inquiry-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.82);
}
.inquiry-btn {
  background: #fff;
  color: #1565C0;
  font-size: 28rpx;
  font-weight: 700;
  padding: 18rpx 38rpx;
  border-radius: 999rpx;
  z-index: 1;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.10);
  transition: transform .15s ease;
}
.inquiry-card:active .inquiry-btn { transform: scale(0.96); }
