<view class="page-container">

  <!-- 轮播Banner -->
  <swiper
    class="banner-swiper"
    autoplay circular
    interval="4500"
    duration="700"
    easing-function="easeInOutCubic"
    indicator-dots
    indicator-color="rgba(255,255,255,0.35)"
    indicator-active-color="#ffffff"
    bindchange="onBannerChange"
  >
    <swiper-item wx:for="{{banners}}" wx:key="index">
      <view class="banner-slide" style="background:{{item.bg}}">
        <!-- 背景装饰圆 -->
        <view class="banner-deco-1"></view>
        <view class="banner-deco-2"></view>
        <!-- 文字 -->
        <view class="banner-content">
          <view class="banner-tag">{{item.tag}}</view>
          <view class="banner-title">{{item.title}}</view>
          <view class="banner-subtitle">{{item.subtitle}}</view>
        </view>
        <!-- 产品图 -->
        <image class="banner-product-img" src="{{item.image}}" mode="aspectFit" />
      </view>
    </swiper-item>
  </swiper>

  <!-- 联系电话条 -->
  <view class="phone-bar" bindtap="callPhone">
    <view class="phone-icon-wrap">
      <text class="phone-icon">☎</text>
    </view>
    <view class="phone-info">
      <text class="phone-label">联系我们</text>
      <text class="phone-number">{{company.phone}}</text>
    </view>
    <text class="phone-tip">点击拨打</text>
  </view>

  <!-- 产品分类 -->
  <view class="section-title">产品分类</view>
  <view class="category-grid">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item"
      bindtap="goToCategory"
      data-id="{{item.id}}"
    >
      <view class="cat-img-wrap">
        <image class="cat-img" src="{{item.image}}" mode="aspectFit" lazy-load />
      </view>
      <text class="cat-name">{{item.name}}</text>
      <text class="cat-count" wx:if="{{item.productCount > 0}}">{{item.productCount}}款</text>
      <text class="cat-count preparing" wx:else>整理中</text>
    </view>
  </view>

  <!-- 快捷询价 -->
  <view class="inquiry-card" bindtap="goToInquiry">
    <view class="inquiry-deco"></view>
    <view class="inquiry-left">
      <text class="inquiry-title">需要报价？</text>
      <text class="inquiry-sub">{{company.workingHours}}</text>
    </view>
    <view class="inquiry-btn">立即询价 ›</view>
  </view>

</view>
