<view class="page-container">

  <!-- 分类头部 -->
  <view wx:if="{{category}}" class="cat-header" style="background:{{category.bgColor}}">
    <view class="cat-header-icon" style="color:{{category.color}}">{{category.icon}}</view>
    <view class="cat-header-info">
      <view class="cat-header-name" style="color:{{category.color}}">{{category.name}}</view>
      <view class="cat-header-desc">{{category.description}}</view>
      <view class="cat-header-count" style="color:{{category.color}}">共 {{products.length}} 款产品</view>
    </view>
  </view>

  <!-- 无产品提示 -->
  <view wx:if="{{products.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">规格信息整理中，敬请期待</text>
    <text class="empty-sub">如需了解此类产品，请致电咨询</text>
  </view>

  <!-- 产品列表 -->
  <block wx:else>
    <view wx:for="{{products}}" wx:key="id" class="product-card card">

      <!-- 产品缩略图 -->
      <view
        class="product-thumb"
        style="background:{{category.bgColor}}"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <image
          wx:if="{{item.images && item.images.length}}"
          src="{{item.images[0]}}"
          mode="aspectFill"
          class="thumb-img"
          lazy-load
        />
        <text wx:else class="product-thumb-text" style="color:{{category.color}}">{{category.icon}}</text>
      </view>

      <!-- 产品信息 -->
      <view class="product-body" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="product-name">{{item.name}}</view>
        <view class="product-model">{{item.model}}</view>
        <view class="product-specs-preview">
          <text
            wx:for="{{item.specs}}"
            wx:key="key"
            wx:if="{{index < 2}}"
            class="spec-preview-item"
          >{{item.key}}：{{item.value}}</text>
        </view>
        <view class="product-tags">
          <text
            wx:for="{{item.tags}}"
            wx:key="*this"
            wx:for-item="tag"
            wx:if="{{index < 3}}"
            class="tag"
          >{{tag}}</text>
        </view>
      </view>

    </view>
  </block>

</view>
