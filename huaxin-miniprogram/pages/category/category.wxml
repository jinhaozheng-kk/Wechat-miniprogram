<view class="page-container">

  <!-- 分类页头：编辑部式大标题 -->
  <view wx:if="{{category}}" class="cat-head reveal">
    <view class="cat-head-title">{{category.name}}</view>
    <view class="cat-head-desc">{{category.description}}</view>
    <view class="cat-head-count">共 {{products.length}} 款产品</view>
  </view>

  <!-- 无产品提示 -->
  <view wx:if="{{products.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">规格信息整理中，敬请期待</text>
    <text class="empty-sub">如需了解此类产品，请致电咨询</text>
  </view>

  <!-- 产品列表 -->
  <block wx:else>
    <view
      wx:for="{{products}}"
      wx:key="id"
      class="product-card card card-tap reveal {{index < 6 ? 'reveal-d' + (index + 1) : 'reveal-d6'}}"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <!-- 产品图：透明底悬浮 -->
      <view class="product-thumb">
        <image
          wx:if="{{item.images && item.images.length}}"
          src="{{item.images[0]}}"
          mode="aspectFit"
          class="thumb-img"
          lazy-load
        />
        <text wx:else class="product-thumb-text">{{category.icon}}</text>
      </view>

      <!-- 产品信息 -->
      <view class="product-body">
        <view class="product-name">{{item.name}}</view>
        <view class="product-model">{{item.model}}</view>
        <view class="product-specs-preview">
          <text
            wx:for="{{item.specs}}"
            wx:key="key"
            wx:if="{{index < 2}}"
            class="spec-preview-item"
          >{{item.key}}：{{item.value}}</text>
        </view>
        <view class="product-go">查看详情 ›</view>
      </view>

    </view>
  </block>

</view>
