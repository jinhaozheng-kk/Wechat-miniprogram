/* =========================================================
   分类详情页样式
   ========================================================= */

/* 分类头部（带渐变叠加 + 装饰圆） */
.cat-header {
  position: relative;
  display: flex;
  align-items: center;
  padding: 44rpx 32rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
}
.cat-header::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.35);
}
.cat-header-icon {
  font-size: 76rpx;
  font-weight: 800;
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.05);
  z-index: 1;
}
.cat-header-info { flex: 1; z-index: 1; }
.cat-header-name {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}
.cat-header-desc {
  font-size: 24rpx;
  color: #455A6F;
  line-height: 1.5;
  margin-bottom: 10rpx;
}
.cat-header-count {
  font-size: 22rpx;
  font-weight: 600;
  display: inline-block;
  background: rgba(255,255,255,0.55);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

/* 产品卡片（左缩略图 + 右信息） */
.product-card {
  display: flex;
  margin: 14rpx 24rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 20rpx;
  transition: transform .15s ease;
}
.product-card:active { transform: scale(0.99); }

.product-thumb {
  position: relative;
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}
.product-thumb-text {
  font-size: 64rpx;
  font-weight: 800;
  opacity: 0.65;
}
.thumb-img {
  width: 200rpx;
  height: 200rpx;
}

.product-body {
  flex: 1;
  padding: 24rpx 24rpx 24rpx 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2233;
  margin-bottom: 8rpx;
  line-height: 1.4;
}
.product-model {
  font-size: 22rpx;
  color: #97A3B4;
  margin-bottom: 12rpx;
}
.product-specs-preview { margin-bottom: 14rpx; }
.spec-preview-item {
  display: block;
  font-size: 22rpx;
  color: #5B6B7E;
  line-height: 1.7;
}
.product-tags {
  display: flex;
  flex-wrap: wrap;
}
