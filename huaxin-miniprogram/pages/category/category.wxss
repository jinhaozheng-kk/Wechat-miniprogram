/* =========================================================
   分类详情页 · 编辑部大标题 + 悬浮图产品卡
   ========================================================= */

/* 页头 */
.cat-head {
  padding: 36rpx 36rpx 16rpx;
}
.cat-head-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #1D1D1F;
  letter-spacing: -1.2rpx;
  line-height: 1.25;
}
.cat-head-desc {
  font-size: 26rpx;
  color: #86868B;
  margin-top: 10rpx;
  line-height: 1.6;
}
.cat-head-count {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 500;
  color: #6E6E73;
  background: rgba(0, 0, 0, 0.045);
  padding: 8rpx 20rpx;
  border-radius: 980rpx;
  margin-top: 18rpx;
}

/* 产品卡片：左悬浮图 + 右信息 */
.product-card {
  display: flex;
  align-items: center;
  margin: 14rpx 32rpx;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
}

.product-thumb {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}
.product-thumb-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #D1D1D6;
}
.thumb-img {
  width: 220rpx;
  height: 220rpx;
  filter: drop-shadow(0 10rpx 18rpx rgba(0, 0, 0, 0.10));
}

.product-body {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.product-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 6rpx;
  line-height: 1.4;
  letter-spacing: -0.3rpx;
}
.product-model {
  font-size: 22rpx;
  color: #AEAEB2;
  margin-bottom: 14rpx;
}
.product-specs-preview { margin-bottom: 16rpx; }
.spec-preview-item {
  display: block;
  font-size: 22rpx;
  color: #6E6E73;
  line-height: 1.7;
}
.product-go {
  font-size: 24rpx;
  font-weight: 600;
  color: #1565C0;
}
