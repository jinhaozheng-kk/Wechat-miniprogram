<view class="page-container" wx:if="{{product}}">

  <!-- 产品展台：径向光 + 透明底图轮播 -->
  <swiper
    wx:if="{{product.images && product.images.length}}"
    class="img-swiper"
    indicator-dots="{{product.images.length > 1}}"
    indicator-color="rgba(0,0,0,0.15)"
    indicator-active-color="#1D1D1F"
    autoplay circular
    interval="3500"
    duration="500"
    easing-function="easeInOutCubic"
  >
    <swiper-item wx:for="{{product.images}}" wx:key="index">
      <image src="{{item}}" mode="aspectFit" class="swiper-img" lazy-load />
    </swiper-item>
  </swiper>
  <!-- 无图时占位 -->
  <view wx:else class="product-hero">
    <text class="hero-icon">{{category.icon}}</text>
  </view>

  <!-- 产品基本信息：悬浮玻璃卡 -->
  <view class="info-card reveal">
    <view class="product-title">{{product.name}}</view>
    <view class="product-model-row">
      <text class="product-model-label">型号/规格</text>
      <text class="product-model-value">{{product.model}}</text>
    </view>
    <view class="tags-row">
      <text wx:for="{{product.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text>
    </view>
  </view>

  <!-- 规格参数 -->
  <view class="section-title reveal reveal-d2">规格参数</view>
  <view class="specs-card card reveal reveal-d3">
    <view wx:for="{{product.specs}}" wx:key="key" class="spec-row">
      <text class="spec-key">{{item.key}}</text>
      <text class="spec-value">{{item.value}}</text>
    </view>
  </view>

  <!-- 非标定制入口 -->
  <view class="custom-row card-tap reveal reveal-d4" bindtap="goToCustom">
    <view class="custom-row-text">
      <view class="custom-row-title">规格不合适？支持非标定制</view>
      <view class="custom-row-sub">本型号可改尺寸 / 材质 / 开孔，来图来样加工</view>
    </view>
    <view class="custom-row-btn">去定制</view>
  </view>

  <!-- 说明 -->
  <view class="note-bar reveal reveal-d5">
    <text class="note-text">· 以上规格如有变动，以实物为准  · 价格请致电咨询</text>
  </view>

  <!-- 底部操作栏：电话 + 询价 -->
  <view class="action-bar">
    <view class="btn-call" bindtap="callPhone">
      <text class="btn-call-icon">☎</text>
    </view>
    <view class="btn-inquiry" bindtap="goToInquiry">立即询价</view>
  </view>

</view>
