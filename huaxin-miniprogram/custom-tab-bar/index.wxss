/* 自定义 tab bar · 悬浮毛玻璃 Dock（苹果风） */
.tab-bar-wrap {
  padding: 0 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.tab-bar {
  display: flex;
  align-items: center;
  height: 116rpx;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 980rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.10);
  padding: 0 12rpx;
}

.tab-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 980rpx;
  color: #86868B;
  transition: color 0.25s ease,
              background 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
              transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.tab-item:active { transform: scale(0.92); }

/* 选中：浅蓝着色胶囊高亮 */
.tab-item.active {
  color: #1565C0;
  background: rgba(21, 101, 192, 0.10);
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1.2;
  margin-bottom: 2rpx;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.tab-item.active .tab-icon {
  transform: translateY(-2rpx) scale(1.08);
}

.tab-text {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 1rpx;
}
.tab-item.active .tab-text {
  font-weight: 700;
}
