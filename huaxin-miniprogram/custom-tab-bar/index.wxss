/* 自定义 tab bar */
.tab-bar {
  position: relative;
  display: flex;
  height: 110rpx;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid #ECEFF4;
  box-shadow: 0 -4rpx 16rpx rgba(20, 50, 100, 0.04);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #97A3B4;
  transition: color 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item.active {
  color: #1565C0;
  transform: translateY(-4rpx) scale(1.06);
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1.2;
  margin-bottom: 4rpx;
  transition: filter 0.2s ease;
}
.tab-item.active .tab-icon {
  filter: drop-shadow(0 4rpx 8rpx rgba(21, 101, 192, 0.30));
}

.tab-text {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 1rpx;
}
.tab-item.active .tab-text {
  font-weight: 700;
}
