/* =========================================================
   全局视觉系统
   主蓝 #1565C0  辅蓝 #1976D2  深蓝 #0D47A1
   背景 #F7F8FA  卡片白 #FFFFFF  边线 #ECEFF4
   主文 #1A2233  次文 #5B6B7E  弱文 #97A3B4  极弱 #C9D1DC
   ========================================================= */

/* 页面全局 */
page {
  background-color: #F7F8FA;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  color: #1A2233;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 通用容器 */
.page-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 50, 100, 0.06);
  transition: transform .2s ease, box-shadow .2s ease;
}

/* 可点击卡片：按下反馈 */
.card-tap:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 10rpx rgba(20, 50, 100, 0.04);
}

/* 分区标题（左侧蓝色短竖线装饰） */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A2233;
  padding: 28rpx 24rpx 16rpx;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #1565C0, #1976D2);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

/* 主按钮（渐变 + 阴影 + 按下反馈） */
.btn-primary {
  background: linear-gradient(135deg, #1565C0 0%, #1976D2 100%);
  color: #fff;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(21, 101, 192, 0.30);
  transition: transform .15s ease, box-shadow .15s ease;
}
.btn-primary::after { border: none; }
.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(21, 101, 192, 0.30);
}

/* 次要按钮 */
.btn-secondary {
  background: #fff;
  color: #1565C0;
  border: 2rpx solid #1565C0;
  border-radius: 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  transition: transform .15s ease, background .15s ease;
}
.btn-secondary::after { border: none; }
.btn-secondary:active {
  background: #F0F4FA;
  transform: scale(0.98);
}

/* 标签（胶囊） */
.tag {
  display: inline-block;
  background: #E8F2FE;
  color: #1565C0;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin: 4rpx 6rpx 4rpx 0;
}

/* 规格表 */
.spec-table { width: 100%; }
.spec-row {
  display: flex;
  border-bottom: 1rpx solid #F0F4FA;
  padding: 22rpx 0;
}
.spec-row:last-child { border-bottom: none; }
.spec-key {
  width: 220rpx;
  color: #5B6B7E;
  font-size: 26rpx;
  flex-shrink: 0;
}
.spec-value {
  flex: 1;
  color: #1A2233;
  font-size: 26rpx;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #97A3B4;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; opacity: 0.85; }
.empty-text { font-size: 28rpx; }

/* 推荐徽章 */
.badge-recommended {
  background: linear-gradient(135deg, #FF8A00, #FF6F00);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
  vertical-align: middle;
  font-weight: 500;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #ECEFF4;
  margin: 0 24rpx;
}

/* 渐变文字（用于 CTA 强调） */
.text-gradient {
  background: linear-gradient(135deg, #1565C0, #1976D2);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-weight: 700;
}
