/* =========================================================
   全局视觉系统 · 苹果式浅色极简（v4）
   ----------------------------------------------------------
   背景    #F5F5F7   卡片 #FFFFFF
   主文    #1D1D1F   次文 #6E6E73   弱文 #86868B   极弱 #AEAEB2
   点缀蓝  #1565C0（品牌蓝，仅用于按钮/链接/选中态）
   反差黑  #1D1D1F（深色卡片/强 CTA）
   圆角    卡片 32rpx   按钮 980rpx（胶囊）  小件 20rpx
   分隔    hairline rgba(0,0,0,0.06)，不用重阴影
   动效    标准 cubic-bezier(0.25,0.1,0.25,1)
           弹性 cubic-bezier(0.34,1.56,0.64,1)
   ========================================================= */

/* 页面全局 */
page {
  background-color: #F5F5F7;
  font-family: -apple-system, "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1D1D1F;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 通用容器（给悬浮 dock 预留空间） */
.page-container {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 卡片：白底大圆角，极轻阴影 + hairline 描边 */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  margin: 16rpx 32rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
              opacity 0.2s cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* 可点击卡片：按下整体微缩（iOS 质感） */
.card-tap {
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
              opacity 0.2s cubic-bezier(0.25, 0.1, 0.25, 1);
}
.card-tap:active {
  transform: scale(0.975);
  opacity: 0.92;
}

/* 编辑部式页头（各页共用） */
.page-head {
  padding: 28rpx 36rpx 4rpx;
}
.page-head-title {
  font-size: 60rpx;
  font-weight: 800;
  color: #1D1D1F;
  letter-spacing: -1.5rpx;
  line-height: 1.2;
}
.page-head-sub {
  font-size: 26rpx;
  color: #86868B;
  margin-top: 8rpx;
}

/* 分区标题：去装饰，纯大字重排版 */
.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.5rpx;
  padding: 44rpx 36rpx 18rpx;
}

/* 分区副标题（标题下方的灰色说明） */
.section-caption {
  font-size: 24rpx;
  color: #86868B;
  padding: 0 36rpx 18rpx;
  margin-top: -10rpx;
}

/* 主按钮：纯色胶囊，无渐变无彩色阴影 */
.btn-primary {
  background: #1565C0;
  color: #FFFFFF;
  border-radius: 980rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: none;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
              opacity 0.2s ease;
}
.btn-primary::after { border: none; }
.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.85;
}

/* 次要按钮：浅蓝着色填充（iOS tinted button），无描边 */
.btn-secondary {
  background: rgba(21, 101, 192, 0.10);
  color: #1565C0;
  border: none;
  border-radius: 980rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
              background 0.2s ease;
}
.btn-secondary::after { border: none; }
.btn-secondary:active {
  background: rgba(21, 101, 192, 0.18);
  transform: scale(0.96);
}

/* 标签（中性灰胶囊，克制不抢戏） */
.tag {
  display: inline-block;
  background: rgba(0, 0, 0, 0.045);
  color: #6E6E73;
  border-radius: 980rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin: 4rpx 8rpx 4rpx 0;
}

/* 规格表 */
.spec-table { width: 100%; }
.spec-row {
  display: flex;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 24rpx 0;
}
.spec-row:last-child { border-bottom: none; }
.spec-key {
  width: 220rpx;
  color: #86868B;
  font-size: 26rpx;
  flex-shrink: 0;
}
.spec-value {
  flex: 1;
  color: #1D1D1F;
  font-size: 26rpx;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx;
  color: #AEAEB2;
}
.empty-icon {
  font-size: 88rpx;
  margin-bottom: 28rpx;
  opacity: 0.6;
  filter: grayscale(1);
}
.empty-text { font-size: 28rpx; color: #86868B; }
.empty-sub  { font-size: 24rpx; color: #AEAEB2; margin-top: 10rpx; }

/* 推荐徽章（苹果橙，纯色） */
.badge-recommended {
  background: #FF9500;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 980rpx;
  margin-left: 12rpx;
  vertical-align: middle;
  font-weight: 600;
}

/* 分割线（hairline） */
.divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
  margin: 0 32rpx;
}

/* 强调文字：纯色品牌蓝（替代旧渐变文字） */
.text-gradient {
  color: #1565C0;
  font-weight: 700;
}

/* 链接文字 */
.text-link {
  color: #1565C0;
  font-weight: 500;
}

/* =========================================================
   入场动画系统：.reveal + .reveal-d1~d6 错峰延迟
   用法：<view class="card reveal reveal-d2">
   ========================================================= */
@keyframes reveal-up {
  0%   { opacity: 0; transform: translateY(32rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
.reveal {
  animation: reveal-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.reveal-d1 { animation-delay: 0.07s; }
.reveal-d2 { animation-delay: 0.14s; }
.reveal-d3 { animation-delay: 0.21s; }
.reveal-d4 { animation-delay: 0.28s; }
.reveal-d5 { animation-delay: 0.35s; }
.reveal-d6 { animation-delay: 0.42s; }
