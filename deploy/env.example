# Copy this file to /etc/huaxin/huaxin-server.env on the server.
# Replace every CHANGE_ME value before starting the service.

SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=huaxin
DB_USERNAME=huaxin
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

HUAXIN_UPLOAD_DIR=/opt/huaxin/upload
HUAXIN_ADMIN_USERNAME=admin
HUAXIN_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
HUAXIN_ADMIN_TOKEN=CHANGE_ME_RANDOM_LONG_TOKEN
