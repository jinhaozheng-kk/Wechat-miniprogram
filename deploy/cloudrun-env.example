# 微信云托管服务环境变量示例
# 在云托管控制台的「服务设置 -> 环境变量」中填写。

SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

# 云托管 MySQL 会自动注入 MYSQL_ADDRESS/MYSQL_USERNAME/MYSQL_PASSWORD。
# 如果改用自定义 MySQL，DB_HOST 需要包含端口，例如 127.0.0.1:3306。
DB_HOST=CHANGE_ME_MYSQL_HOST:3306
DB_NAME=huaxin
DB_USERNAME=huaxin
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# 云托管容器内上传目录。云托管实例本地文件不适合做长期持久化；
# 后续如果后台上传图片较多，建议接入对象存储。
HUAXIN_UPLOAD_DIR=/tmp/huaxin-upload

HUAXIN_ADMIN_USERNAME=admin
HUAXIN_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
HUAXIN_ADMIN_TOKEN=CHANGE_ME_RANDOM_LONG_TOKEN
