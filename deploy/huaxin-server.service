[Unit]
Description=Huaxin Mini Program Spring Boot API
After=network.target mysql.service

[Service]
Type=simple
User=huaxin
Group=huaxin
WorkingDirectory=/opt/huaxin
EnvironmentFile=/etc/huaxin/huaxin-server.env
ExecStart=/usr/bin/java -jar /opt/huaxin/server.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
